  state {
    id			    13
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    12
    treeNode		    [12 0 0 0]
    superState		    SUBCHART
    subviewer		    12
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [y1,y2] = fcn(T1,T2,Ts)\nglobal Tsum;\nglobal Tdelt;\nTsum = T1+T2;\nif Tsum > Ts\n    T"
      "1 = T1*Ts/Tsum;\n    T2 = T2*Ts/Tsum;\nend\nif Tsum > 1.154*Ts\n   Tdelt = 1.154*Ts - Tsum;\n   if T1 > T2\n    "
      "   if T2 < Tdelt\n           T2 = 0;\n           T1 = Ts;\n       else\n           T2 = T2 - Tdelt;\n           "
      "T1 = T1 + Tdelt;\n       end\n   else\n       if T1 < Tdelt\n           T1 = 0;\n           T2 = Ts;\n       els"
      "e\n           T1 = T1 - Tdelt;\n           T2 = T2 + Tdelt;\n       end\n   end\nend\n\ny1 = T1;\ny2 = T2;      "
      "  \nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
