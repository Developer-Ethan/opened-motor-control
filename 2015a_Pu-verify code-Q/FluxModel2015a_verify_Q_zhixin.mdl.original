	Annotation {
	  SID			  "2244"
	  Name			  "<!DOCTYPE HTML PUBLIC '-//W3C//DTD HTML 4.0//EN' 'http://www.w3.org/TR/REC-html40/strict.dtd'>\n<html>\n<"
	  "head>\n<meta content=\"1\" name=\"qrichtext\"/>\n<style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</sty"
	  "le>\n</head>\n<body align=\"left\" style=\" font-family:'SimSun'; font-size:12px; font-weight:400; font-style:norma"
	  "l;\">\n<p align=\"left\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-i"
	  "ndent:0; text-indent:0px;\">\n<math style=\"font-size:20px;\">$2.两相静止坐标系电机方程\\\\\nu_\\alpha = R_s  i_\\a"
	  "lpha + L_\\alpha\\frac{di_\\alpha}{dt}+L_{\\alpha\\beta}\\frac{di_\\beta}{dt}-\\omega_e  \\psi_rsin(\\theta)\\\\\nu"
	  "_\\beta = R_s  i_\\beta + L_\\beta\\frac{di_\\beta}{dt}+L_{\\alpha\\beta}\\frac{di_\\alpha}{dt}+\\omega_e  \\psi_rs"
	  "in(\\theta)\\\\\nL=\\frac{1}{2}(L_d+L_q)\\\\\n{\\Delta}L=\\frac{1}{2}(L_d-L_q)\\\\\nL_\\alpha = L + {\\Delta}Lcos(2"
	  "\\theta)\\\\\nL_\\beta = L - {\\Delta}Lcos(2\\theta)\\\\\nL_{\\alpha\\beta}= {\\Delta}Lsin(2\\theta)\\\\\n\\\\\n有功"
	  "功率：P=u_\\alpha  i_\\alpha + u_\\beta  i_\\beta\\\\\n无功功率：Q=u_\\beta  i_\\alpha - u_\\alpha  i_\\beta\\\\\n视"
	  "在功率：S=\\sqrt{P^2+Q^2}\\\\$</math>\n</p>\n</body>\n</html>\n"
	  Position		  [593, -52, 985, 596]
	  InternalMargins	  [0, 0, 0, 0]
	  FixedHeight		  on
	  FixedWidth		  on
	  HorizontalAlignment	  "left"
	  VerticalAlignment	  "top"
	  ForegroundColor	  "[0.800000, 0.800000, 0.800000]"
	  BackgroundColor	  "[0.800000, 0.800000, 0.800000]"
	  Interpreter		  "rich"
	  ZOrder		  -16
	}
	Annotation {
	  SID			  "2243"
	  Name			  "<!DOCTYPE HTML PUBLIC '-//W3C//DTD HTML 4.0//EN' 'http://www.w3.org/TR/REC-html40/strict.dtd'>\n<html>\n<"
	  "head>\n<meta content=\"1\" name=\"qrichtext\"/>\n<style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</sty"
	  "le>\n</head>\n<body align=\"left\" style=\" font-family:'SimSun'; font-size:12px; font-weight:400; font-style:norma"
	  "l;\">\n<p align=\"left\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-i"
	  "ndent:0; text-indent:0px;\">\n<math style=\"font-size:20px;\">$3.旋转坐标系电机方程\\\\\n\\psi_d =L_di_d+\\psi_r\\\\"
	  "\n\\psi_q=L_qi_q\\\\\n\nu_d=R_si_d+\\frac{d\\psi_d}{dt}-\\omega_e\\psi_q\\\\\nu_q=R_si_q+\\frac{d\\psi_q}{dt}+\\ome"
	  "ga_e\\psi_d\\\\\n\nu_d = R_s  i_d + L_d\\frac{di_d}{dt}-\\omega_eL_qi_q\\\\\nu_q = R_s  i_q + L_q\\frac{di_q}{dt}+\\"
	  "omega_eL_di_d+\\omega_e\\psi_r\\\\\n\\\\\n有功功率：P=u_d  i_d + u_q  i_q\\\\\n无功功率：Q=u_q  i_d - u_d  i_q\\\\\n"
	  "视在功率：S=\\sqrt{P^2+Q^2}\\\\\n\n电磁转矩：T_e=\\frac{3}{2}P_ni_q[i_d(L_d-L_q)+\\psi_r]\\\\\nSPM电磁转矩:T_e=\\fr"
	  "ac{3}{2}P_n\\psi_ri_q$</math>\n</p>\n</body>\n</html>\n"
	  Position		  [996, -49, 1383, 594]
	  InternalMargins	  [0, 0, 0, 0]
	  FixedHeight		  on
	  FixedWidth		  on
	  HorizontalAlignment	  "left"
	  VerticalAlignment	  "top"
	  ForegroundColor	  "[0.800000, 0.800000, 0.800000]"
	  BackgroundColor	  "[0.800000, 0.800000, 0.800000]"
	  Interpreter		  "rich"
