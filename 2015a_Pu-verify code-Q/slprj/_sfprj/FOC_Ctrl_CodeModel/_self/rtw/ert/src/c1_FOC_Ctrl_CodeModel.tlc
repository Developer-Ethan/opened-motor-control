%implements "chartSource" "C"
%function ChartConfig(block, system) void
  %createrecord chartConfiguration { ...
          executeAtInitialization  0 ...
  }
  %return chartConfiguration
%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   5 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "is_active_c1_FOC_Ctrl_CodeModel"\
      Description  "StateIsActive"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_c1_FOC_Ctrl_CodeModel"\
      Description  "StateActiveChild"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_Run"\
      Description  "StateActiveChild"\
      SFName       ""\
      Path         "Run"\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "CalCnt"\
      Description  "ChartLocal"\
      SFName       ""\
      Path         "CalCnt"\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "InitDone"\
      Description  "ChartLocal"\
      SFName       ""\
      Path         "InitDone"\
      SrcLocation  ""\
    }\
  }
  %return ChartDataElements
%endfunction
